  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestionBox2D
  question: Pak Rahmat menyusun meja dan kursi untuk ruang rapat. 1 meja dapat dikelilingi
    6 kursi. jika 2 meja digabungkan dapat dikelilingi 10 kursi. jika 3 meja digabungkan,
    dapat dikelilingi 14 kursi. Berapa banyak kursi yang dibutuhkan jika Pak Rahmat
    menggabungkan 5 meja secara sejajar?
  options:
  - 18 kursi
  - 20 kursi
  - 22 kursi
  - 24 kursi
  correctAnswerIndex: 2
  questionUI: {fileID: 2045793180}
  hideOnCorrect: 1
  breakEffect: {fileID: 0}
